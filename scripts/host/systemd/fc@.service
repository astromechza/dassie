# One Firecracker microVM per instance, run by `dassie vm-run` (ADR 0012).
# Hand-written until M2's daemon renders units. Install and drills: README.md
# next to this file.
#
# Instance %i reads /var/lib/dassie/vms/%i/config.json (from
# scripts/host/vm-config.sh) and gets the vsock socket /run/dassie/%i.vsock.
# vm-run listens for the guest's events on /run/dassie/%i.vsock_1024, and
# removes either socket if a killed run left it behind.
# fc@.service.d/net.conf adds its TAP, dassie-tap@%i (ADR 0008).

[Unit]
Description=dassie microVM %i
After=network.target
# A guest that keeps exiting stops being restarted after 5 starts in 60 s.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# vm-run sends READY=1 when the guest reports `ready`, so the unit is active
# once the app is, not when Firecracker starts.
Type=notify
NotifyAccess=main
RuntimeDirectory=dassie
RuntimeDirectoryPreserve=yes
# Exit status: the app's exit code (128+N for signal N), 0 after a stop,
# 196 if no `exited` event arrived, 197 if the VM could not run. Events go to
# the journal with DASSIE_EVENT fields: journalctl -u fc@%i -o verbose.
ExecStart=/usr/local/bin/dassie vm-run --config /var/lib/dassie/vms/%i/config.json
# SIGTERM reaches vm-run alone. It asks the guest to stop over the control
# channel (ADR 0004), waits for the guest to reboot and Firecracker to exit,
# and kills Firecracker after 15 s. Whatever is left is SIGKILLed.
KillMode=mixed
TimeoutStopSec=30
# Entrypoint exit -> guest reboot -> Firecracker exits -> vm-run exits -> restart.
Restart=always
RestartSec=1
# The serial console is Firecracker's stdout.
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
