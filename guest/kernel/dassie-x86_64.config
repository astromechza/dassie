# x86_64 only. Firecracker's SendCtrlAltDel action presses Ctrl-Alt-Del on an
# emulated i8042 keyboard; the guest needs the driver to see it. dassie-init
# disables the reboot and receives it as SIGINT, a graceful stop.
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
