# Options dassie-init and the host contract rely on, merged over Firecracker's
# recommended guest config. build.sh fails if any of these is lost.
#
# Each line must be exactly as it appears in the final .config.

# Shared initramfs (ADR 0006), gzip-compressed.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# /dev for the initramfs and the app rootfs.
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# Devices: virtio-mmio transport, root drive, NIC, vsock to the host.
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# Read-only root drive (ADR 0009) with an overlay in the guest (ADR 0006):
# erofs with its xattrs, ACLs and lz4 decompression, and a tmpfs upper layer
# that keeps xattrs on copy-up.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
# Serial console, which reaches journald through Firecracker's stdout.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# Loopback for the readiness probe; eth0 addressing from `ip=`.
CONFIG_INET=y
CONFIG_IP_PNP=y
