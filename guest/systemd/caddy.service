# The HTTPS ingress for every VM (ADR 0010): one hostname per route,
# reverse-proxied to the guest's address over its routed TAP (ADR 0008).
# Install and drills: README.md next to this file.
#
# /etc/dassie/caddy.json is the whole config and its only source of truth:
# `persist: false` stops Caddy saving its own copy, and every change is a
# whole-file reload through the admin API on /run/caddy/admin.sock. There is
# no admin port on TCP. In M1 guest/deploy-image.sh writes the file; from M2
# the daemon does.
#
# Not ordered against any VM: a route to a VM that is not up yet answers 502
# until it is.

[Unit]
Description=Caddy, the HTTPS ingress for dassie VMs
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/caddy run --config /etc/dassie/caddy.json
ExecReload=/usr/local/bin/caddy reload --config /etc/dassie/caddy.json --address unix//run/caddy/admin.sock --force
# No account to create: systemd allocates a user per start. Caddy's storage
# (the `tls internal` CA and certificates) lives in /var/lib/caddy, which
# systemd keeps across starts and hands to whichever uid this start gets.
DynamicUser=yes
StateDirectory=caddy
# The admin socket. Only this unit's user and root can connect to it.
RuntimeDirectory=caddy
# A dynamic user has no home; keep anything Caddy writes outside `storage`
# in the state directory too.
Environment=XDG_DATA_HOME=%S/caddy XDG_CONFIG_HOME=%S/caddy
# :80 and :443, and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=1048576
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
