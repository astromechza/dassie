# One Firecracker microVM per instance, hand-written for M0 (ADR 0006).
# Install and drills: README.md next to this file.
#
# Instance %i reads /var/lib/dassie/vms/%i/config.json (from
# guest/vm-config.sh) and gets the vsock socket /run/dassie/%i.vsock. The
# host listener for its events binds /run/dassie/%i.vsock_1024.

[Unit]
Description=dassie microVM %i
After=network.target
# A guest that keeps exiting stops being restarted after 5 starts in 60 s.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# /run/dassie also holds the host listener's sockets, so it outlives the unit.
RuntimeDirectory=dassie
RuntimeDirectoryPreserve=yes
# A killed Firecracker leaves its vsock socket behind, and the next start
# would fail to bind it.
ExecStartPre=/bin/rm -f /run/dassie/%i.vsock
# --no-api: the config file is the whole VM; no API socket to collide on.
ExecStart=/usr/local/bin/firecracker --no-api --id %i --config-file /var/lib/dassie/vms/%i/config.json
# Graceful stop over the control channel (ADR 0004): the guest SIGTERMs the
# entrypoint, reboots once it exits, and Firecracker exits. systemd kills
# whatever is left as soon as ExecStop returns, so wait for Firecracker.
# If the request fails, return at once and let systemd kill the VM.
# systemd also runs ExecStop after Firecracker exits on its own (guest
# reboot); MAINPID is then empty and there is nothing to stop.
ExecStop=/bin/sh -c '[ -n "$$MAINPID" ] || exit 0; /usr/local/bin/dassie-listener stop /run/dassie/%i.vsock && exec tail --pid=$$MAINPID -f /dev/null'
TimeoutStopSec=30
# Entrypoint exit -> guest reboot -> Firecracker exits 0 -> restart.
Restart=always
RestartSec=1
# The serial console is Firecracker's stdout.
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
